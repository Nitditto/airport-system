# Copy file này thành .env rồi điền giá trị thật. .env đã nằm trong .gitignore.

# JWT (user-service ký token, api-gateway verify — phải giống nhau, tối thiểu 32 ký tự)
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars

# Tài khoản SYSTEM_ADMIN đầu tiên (user-service) — để trống thì không seed
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay (payment-service)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# VNPay (payment-service)
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/result

# URL frontend mà payment-service redirect về sau khi thanh toán (mặc định http://localhost:5173)
RAZORPAY_CALLBACK_BASE_URL=http://localhost:5173

# Docker Compose (tuỳ chọn)
# FRONTEND_PORT=5173
# VITE_API_BASE_URL=
# CORS_ALLOWED_ORIGINS=
