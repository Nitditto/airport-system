# Copy file này thành .env rồi điền giá trị thật. .env đã nằm trong .gitignore.

# JWT (user-service ký token, api-gateway verify — phải giống nhau, tối thiểu 32 ký tự)
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars

# Razorpay (payment-service)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
